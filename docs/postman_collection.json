              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', function(){ pm.response.to.have.status(201); });",
              "pm.collectionVariables.set('ternakId', pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. POST input salah (harus 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
