              "pm.test('status 404', function(){ pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "5. POST tambah ternak (201)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/ternak",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ternak"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kode\": \"KB-050\",\n  \"jenis\": \"Kambing\",\n  \"ras\": \"Etawa\",\n  \"jenis_kelamin\": \"Jantan\",\n  \"tanggal_lahir\": \"2025-02-01\",\n  \"bobot_kg\": 31.5,\n  \"status\": \"Tersedia\",\n  \"harga_beli\": 2000000,\n  \"catatan\": \"Contoh dari Postman\"\n}"
        },
        "auth": {
          "type": "bearer",
          "bearer": [
